opt_out_usage
default_platform(:ios)

platform :ios do
  desc "Build and push a new build to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: false,
      in_house: false
    )

    get_certificates(
      api_key: api_key,
      keychain_path: File.expand_path("~/Library/Keychains/build.keychain-db"),
      force: true
    )

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.eisen.blockrush2k",
      force: true
    )

    increment_build_number(
      build_number: latest_testflight_build_number(api_key: api_key) + 1
    )

# Build and archive Xcode project with explicit manual signing
    build_app(
      project: "BlockFusion.xcodeproj",
      scheme: "BlockFusion",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          # Make sure the bundle ID matches exactly
          "com.eisen.blockrush2k" => ENV["SIGH_NAME"] || "com.eisen.blockrush2k AppStore"
        }
      },
      xcargs: "CODE_SIGN_STYLE=Manual"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
