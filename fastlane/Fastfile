default_platform(:ios)

platform :ios do
  desc "Build and push a new build to TestFlight"
  lane :beta do
    # Authenticate via the headless App Store Connect API Key
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: false,
      in_house: false
    )

    # Sync certificates and provisioning profiles headlessly
    match(
      type: "appstore",
      readonly: is_ci,
      api_key: api_key
    )

    # Increment build number automatically based on TestFlight's latest version
    increment_build_number(
      build_number: latest_testflight_build_number(api_key: api_key) + 1
    )

    # Compile and archive the app
    build_app(
      scheme: "YourAppScheme",
      export_method: "app-store"
    )

    # Upload binary directly to TestFlight
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
