opt_out_usage
default_platform(:ios)

platform :ios do
  desc "Build and push a new build to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: false,
      in_house: false
    )

    match(
      type: "appstore",
      app_identifier: ["com.eisen.blockrush2k"],
      readonly: true,
      api_key: api_key,
      git_url: ENV.fetch("MATCH_GIT_URL"),
      keychain_name: ENV.fetch("KEYCHAIN_PATH"),
      keychain_password: ENV.fetch("KEYCHAIN_PASSWORD", "")
    )

    increment_build_number(
      build_number: latest_testflight_build_number(api_key: api_key) + 1
    )

    build_app(
      project: "BlockFusion.xcodeproj",
      scheme: "BlockFusion",
      export_method: "app-store",
      xcargs: "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY=Apple Distribution PROVISIONING_PROFILE_SPECIFIER='match AppStore com.eisen.blockrush2k'",
      export_options: {
        provisioningProfiles: {
          "com.eisen.blockrush2k" => "match AppStore com.eisen.blockrush2k"
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
