opt_out_usage
default_platform(:ios)

platform :ios do
  desc "Build and push a new build to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: false,
      in_house: false
    )

    # 1. Generate new distribution certificate + private key in keychain
    get_certificates(
      api_key: api_key,
      create_if_needed: true
    )

    # 2. Download or create App Store profile linked to the certificate
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.eisen.blockrush2k",
      force: true
    )

    # 3. Bump build number from latest TestFlight version
    increment_build_number(
      build_number: latest_testflight_build_number(api_key: api_key) + 1
    )

    # 4. Compile and archive Xcode project
    build_app(
      project: "BlockFusion.xcodeproj",
      scheme: "BlockFusion",
      export_method: "app-store"
    )

    # 5. Upload binary directly to TestFlight
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
